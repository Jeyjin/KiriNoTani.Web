<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — KiriNoTani (霧の谷)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Верхнее меню -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="fs-3 fw-bold text-dark me-2">霧の谷</span>
                    <span class="fs-4 text-pink fw-light">KiriNoTani</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-content navbar-nav flex-grow-1 justify-content-center">
                        <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="About">О базе</a></li>
                        <li class="nav-item"><a class="nav-link px-3" asp-controller="Services" asp-action="Index">Услуги</a></li>
                        <li class="nav-item"><a class="nav-link px-3" asp-controller="Booking" asp-action="Index">Бронирование</a></li>
                        <li class="nav-item"><a class="nav-link px-3" asp-controller="Reviews" asp-action="Index">Отзывы</a></li>
                        <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="Contacts">Контакты</a></li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <!-- Быстрый вызов / Позвонить -->
                        <a href="tel:+79000000000" class="btn btn-sakura-outline rounded-pill px-3">
                            <i class="bi bi-telephone-fill me-1"></i> Позвонить
                        </a>

                        <!-- Если пользователь Админ или Менеджер -->
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <a class="btn btn-dark rounded-pill px-3" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Админка
                            </a>
                        }

                        <!-- Личный кабинет -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a class="btn btn-sakura rounded-pill px-3" asp-controller="Account" asp-action="Profile">
                                <i class="bi bi-person-circle me-1"></i> Профиль
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-sakura rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Вход
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Основной контент (flex-grow-1 растягивает его и держит футер внизу) -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Подвал сайта -->
    <footer class="footer bg-dark text-light py-5 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-3">
                    <h5 class="text-pink fw-bold">KiriNoTani • 霧の谷</h5>
                    <p class="text-muted small mb-3">Гармония природы, традиции онсэнов и японский уют для вашего отдыха.</p>
                    <div class="d-flex gap-3 text-pink fs-5">
                        <a href="#" class="text-pink"><i class="bi bi-telegram"></i></a>
                        <a href="#" class="text-pink"><i class="bi bi-vk"></i></a>
                        <a href="#" class="text-pink"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-md-3">
                    <h6>Навигация</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Home" asp-action="About" class="text-muted text-decoration-none">О базе</a></li>
                        <li><a asp-controller="Services" asp-action="Index" class="text-muted text-decoration-none">Услуги и дома</a></li>
                        <li><a asp-controller="Booking" asp-action="Index" class="text-muted text-decoration-none">Онлайн-бронирование</a></li>
                        <li><a asp-controller="Reviews" asp-action="Index" class="text-muted text-decoration-none">Отзывы гостей</a></li>
                        <li><a asp-controller="Home" asp-action="Contacts" class="text-muted text-decoration-none">Контакты</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6>Юридическая информация</h6>
                    <ul class="list-unstyled small text-muted">
                        <li>ООО «КириноТани Резорт»</li>
                        <li>ОГРН: 1234567890123</li>
                        <li>ИНН: 7700000000 / КПП: 770001001</li>
                        <li><a href="#" class="text-muted text-decoration-none">Политика конфиденциальности</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6>Контакты</h6>
                    <p class="text-muted small mb-1"><i class="bi bi-geo-alt me-2"></i>Японская долина, ул. Туманная, д. 7</p>
                    <p class="text-muted small mb-1"><i class="bi bi-telephone me-2"></i>+7 (900) 000-00-00</p>
                    <p class="text-muted small"><i class="bi bi-envelope me-2"></i>info@kirinotani.web</p>
                </div>
            </div>
            <hr class="my-4 border-secondary border-opacity-50">
            <div class="d-flex justify-content-between align-items-center small text-muted flex-wrap gap-2">
                <span>&copy; 2026 KiriNoTani. Все права защищены.</span>
                <span>Команда разработчиков: <strong>KiriNoTani Web Team</strong></span>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>