@model KiriNoTani.Web.Models.Service

@{
    ViewData["Title"] = "Редактирование услуги";
}

<div class="container py-5">
    <span class="text-pink fw-bold text-uppercase small tracking-widest">Панель управления</span>
    <h1 class="h3 fw-bold mb-4">Редактировать услугу</h1>

    @await Html.PartialAsync("_AdminNav")

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <form asp-action="EditService" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImageUrl" />

                    <div class="mb-3">
                        <label class="form-label small text-muted">Название</label>
                        <input asp-for="Title" class="form-control rounded-pill border-0 bg-light py-2 px-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Цена (₽)</label>
                        <input asp-for="Price" type="number" class="form-control rounded-pill border-0 bg-light py-2 px-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Краткое описание</label>
                        <textarea asp-for="Description" class="form-control rounded-3 border-0 bg-light p-3" rows="2" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Подробное описание</label>
                        <textarea asp-for="FullDescription" class="form-control rounded-3 border-0 bg-light p-3" rows="5"></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small text-muted">Новое изображение (оставьте пустым, чтобы сохранить текущее)</label>
                        <input type="file" name="imageFile" class="form-control rounded-pill border-0 bg-light py-2 px-3" accept="image/*" />
                        
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mt-3">
                                <span class="small text-muted d-block mb-2">Текущее изображение:</span>
                                <img src="@Model.ImageUrl" alt="@Model.Title" style="max-height: 150px;" class="rounded-3 shadow-sm" />
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-sakura rounded-pill px-4 py-2 fw-bold">Сохранить изменения</button>
                        <a asp-action="Services" class="btn btn-light rounded-pill px-4 py-2">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>