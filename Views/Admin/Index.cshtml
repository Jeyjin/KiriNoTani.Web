@model IEnumerable<KiriNoTani.Web.Models.Booking>

@{
    ViewData["Title"] = "Админ-панель";
}

<div class="container py-5">
    <span class="text-pink fw-bold text-uppercase small tracking-widest">Панель управления</span>
    <h1 class="h3 fw-bold mb-4">Администрирование KiriNoTani</h1>

    @await Html.PartialAsync("_AdminNav")

    <!-- Статистика -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <h3 class="display-6 fw-bold text-pink mb-1">@Model.Count()</h3>
                <span class="text-muted small">Всего бронирований</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <h3 class="display-6 fw-bold text-pink mb-1">@ViewBag.TotalServices</h3>
                <span class="text-muted small">Услуг в каталоге</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <h3 class="display-6 fw-bold text-pink mb-1">@ViewBag.TotalUsers</h3>
                <span class="text-muted small">Пользователей</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <h3 class="display-6 fw-bold text-pink mb-1">@ViewBag.TotalReviews</h3>
                <span class="text-muted small">Отзывов клиентов</span>
            </div>
        </div>
    </div>

    <!-- Таблица бронирований -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="p-4 border-bottom">
            <h3 class="h5 fw-bold mb-0">Управление заявками на бронирование</h3>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4">#</th>
                        <th class="py-3">Гость</th>
                        <th class="py-3">Телефон</th>
                        <th class="py-3">Услуга</th>
                        <th class="py-3">Дата заезда</th>
                        <th class="py-3">Статус</th>
                        <th class="py-3 text-end px-4">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold">#@item.Id</td>
                                <td class="fw-medium">@item.GuestName</td>
                                <td class="text-muted">@item.Phone</td>
                                <td>@(item.Service?.Title ?? "—")</td>
                                <td>@item.CheckInDate.ToString("dd.MM.yyyy") в @item.TimeSlot</td>
                                <td>
                                    @if (item.Status == "Подтверждено")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Подтверждено</span>
                                    }
                                    else if (item.Status == "Отменено")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">Отменено</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">Новое</span>
                                    }
                                </td>
                                <td class="text-end px-4">
                                    <div class="d-inline-flex gap-1">
                                        <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="status" value="Подтверждено" />
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3" title="Подтвердить"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                        <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="status" value="Отменено" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Отменить"><i class="bi bi-x-lg"></i></button>
                                        </form>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-action="DeleteBooking" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Удалить"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Заявок на бронирование пока нет.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>