@model IEnumerable<KiriNoTani.Web.Models.Service>

@{
    ViewData["Title"] = "Управление услугами";
}

<div class="container py-5">
    <span class="text-pink fw-bold text-uppercase small tracking-widest">Панель управления</span>
    <h1 class="h3 fw-bold mb-4">Каталог услуг и домиков</h1>

    @await Html.PartialAsync("_AdminNav")

    <div class="row g-4">
        <!-- Форма добавления новой услуги -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 100px;">
                <h3 class="h5 fw-bold mb-3">Добавить новую услугу</h3>
                <form asp-action="CreateService" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="Id" value="0" />
                    
                    <div class="mb-3">
                        <label class="form-label small text-muted">Название</label>
                        <input name="Title" class="form-control rounded-pill border-0 bg-light py-2 px-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Цена (₽)</label>
                        <input name="Price" type="number" class="form-control rounded-pill border-0 bg-light py-2 px-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Краткое описание</label>
                        <textarea name="Description" class="form-control rounded-3 border-0 bg-light p-3" rows="2" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Подробное описание</label>
                        <textarea name="FullDescription" class="form-control rounded-3 border-0 bg-light p-3" rows="4"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Изображение услуги</label>
                        <input type="file" name="imageFile" class="form-control rounded-pill border-0 bg-light py-2 px-3" accept="image/*" />
                    </div>
                    <button type="submit" class="btn btn-sakura w-100 rounded-pill py-2 fw-bold">Добавить услугу</button>
                </form>
            </div>
        </div>

        <!-- Таблица услуг -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3 px-4">Услуга</th>
                                <th class="py-3">Цена</th>
                                <th class="py-3 text-end px-4">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4">
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Title" style="width: 56px; height: 56px; object-fit: cover;" class="rounded-3 shadow-sm" />
                                            }
                                            <div>
                                                <div class="fw-bold">@item.Title</div>
                                                <div class="text-muted small">@item.Description</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="fw-bold text-pink text-nowrap">@item.Price.ToString("N0") ₽</td>
                                    <td class="text-end px-4 text-nowrap">
                                        <a asp-action="EditService" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-1">
                                            <i class="bi bi-pencil"></i> Изменить
                                        </a>
                                        <form asp-action="DeleteService" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="bi bi-trash"></i> Удалить
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>