@{
    ViewData["Title"] = "О базе отдыха";
}

<div class="container py-5">
    <!-- Шапка страницы -->
    <div class="text-center mb-5">
        <span class="text-pink fw-bold text-uppercase small tracking-widest">Философия KiriNoTani</span>
        <h1 class="fw-bold display-5">Долина тумана и гармонии</h1>
        <p class="text-muted mx-auto" style="max-width: 700px;">
            KiriNoTani (霧の谷) — это уникальное пространство, где традиционная японская эстетика сочетается с современным комфортом дикой природы.
        </p>
    </div>

    <!-- История и миссия -->
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <div class="ratio ratio-16x9 bg-secondary rounded-4 shadow-sm text-white-50 d-flex align-items-center justify-content-center">
                <img src="~/images/about-resort.jpg" alt="База отдыха KiriNoTani" class="w-100 h-100 object-fit-cover" />
            </div>
        </div>
        <div class="col-lg-6">
            <h2 class="fw-bold mb-3">История создания</h2>
            <p class="text-muted mb-3">
                Наша база отдыха была основана с идеей создания места, где каждый гость сможет замедлиться, отдохнуть от информационного шума и восстановить силы в гармонии с окружающим миром.
            </p>
            <p class="text-muted mb-4">
                Название переводится как «Долина тумана», ведь по утрам наши холмы укутывает легкая белая дымка, создающая атмосферу умиротворения и сказочного уединения.
            </p>
            <div class="d-flex gap-4">
                <div>
                    <h3 class="fw-bold text-pink display-6 mb-0">15+</h3>
                    <p class="text-muted small">Домиков в стиле минka</p>
                </div>
                <div>
                    <h3 class="fw-bold text-pink display-6 mb-0">100%</h3>
                    <p class="text-muted small">Экологичные материалы</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Инфраструктура и правила -->
    <div class="row g-4 mt-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <div class="text-pink fs-3 mb-3"><i class="bi bi-house-heart"></i></div>
                <h3 class="h5 fw-bold mb-2">Инфраструктура</h3>
                <p class="text-muted small mb-0">На территории расположены кедровые бани, чайные павильоны, прогулочные эко-тропы и пруд с японскими карпами.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <div class="text-pink fs-3 mb-3"><i class="bi bi-shield-check"></i></div>
                <h3 class="h5 fw-bold mb-2">Правила отдыха</h3>
                <p class="text-muted small mb-0">Мы поддерживаем атмосферу тишины и уважения к природе. После 23:00 на территории действует режим спокойствия.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <div class="text-pink fs-3 mb-3"><i class="bi bi-flower1"></i></div>
                <h3 class="h5 fw-bold mb-2">Забота о гостях</h3>
                <p class="text-muted small mb-0">Индивидуальный подход к каждому посетителю, помощь в организации чайных церемоний и экскурсий.</p>
            </div>
        </div>
    </div>
</div>