@model IEnumerable<KiriNoTani.Web.Models.Review>

@{
    ViewData["Title"] = "Отзывы гостей";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="text-pink fw-bold text-uppercase small tracking-widest">Впечатления</span>
        <h1 class="fw-bold">Отзывы наших гостей</h1>
        <p class="text-muted">Здесь собраны реальные мнения тех, кто уже побывал в KiriNoTani.</p>
    </div>

    <!-- Уведомления -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm mb-4 text-center">
            @TempData["Message"]
        </div>
    }

    <!-- Форма добавления отзыва (Только для авторизованных) -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h3 class="h5 fw-bold mb-3 text-center">Оставить свой отзыв</h3>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label small text-muted">Ваша оценка</label>
                            <select name="Rating" class="form-select rounded-pill border-0 bg-light py-2 px-3" required>
                                <option value="5">⭐⭐⭐⭐⭐ (5 - Великолепно)</option>
                                <option value="4">⭐⭐⭐⭐ (4 - Хорошо)</option>
                                <option value="3">⭐⭐⭐ (3 - Нормально)</option>
                                <option value="2">⭐⭐ (2 - Плохо)</option>
                                <option value="1">⭐ (1 - Ужасно)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted">Ваш отзыв</label>
                            <textarea name="Content" class="form-control rounded-3 border-0 bg-light p-3" rows="4" placeholder="Поделитесь своими впечатлениями об отдыхе..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-sakura w-100 rounded-pill py-2 fw-bold shadow-sm">
                            Отправить отзыв на модерацию
                        </button>
                    </form>
                }
                else
                {
                    <div class="text-center py-3">
                        <p class="text-muted mb-3">Чтобы оставить отзыв, пожалуйста, войдите в свой личный кабинет или зарегистрируйтесь.</p>
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sakura rounded-pill px-4">Войти</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-sakura-outline rounded-pill px-4">Регистрация</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Список одобренных отзывов -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var review in Model)
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-warning small">
                                    @for (int i = 0; i < review.Rating; i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                </span>
                                <span class="text-muted small">@review.CreatedAt.ToString("dd.MM.yyyy")</span>
                            </div>
                            <p class="text-muted small mb-3">«@review.Content»</p>
                        </div>
                        <h6 class="fw-bold mb-0 text-dark">@review.Author</h6>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-4 text-muted">
                Пока нет опубликованных отзывов. Будьте первыми!
            </div>
        }
    </div>
</div>