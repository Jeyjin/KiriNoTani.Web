@model KiriNoTani.Web.Models.Booking

@{
    ViewData["Title"] = "Бронирование отдыха";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <span class="text-pink fw-bold text-uppercase small tracking-widest">KiriNoTani 霧の谷</span>
                    <h1 class="h3 fw-bold mt-1">Оформление бронирования</h1>
                    <p class="text-muted small">Заполните форму, и наш администратор свяжется с вами для подтверждения.</p>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ServiceId" class="form-label fw-medium">Выберите услугу / домик</label>
                        <select asp-for="ServiceId" class="form-select rounded-pill border-0 bg-light py-2 px-3" 
                                asp-items="@(new SelectList(ViewBag.Services, "Id", "Title"))">
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="GuestName" class="form-label fw-medium">Ваше имя</label>
                            <input asp-for="GuestName" class="form-control rounded-pill border-0 bg-light py-2 px-3" placeholder="например, Анна" required />
                            <span asp-validation-for="GuestName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label fw-medium">Номер телефона</label>
                            <input asp-for="Phone" class="form-control rounded-pill border-0 bg-light py-2 px-3" placeholder="+7 (900) 000-00-00" required />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CheckInDate" class="form-label fw-medium">Дата заезда</label>
                            <input asp-for="CheckInDate" class="form-control rounded-pill border-0 bg-light py-2 px-3" type="date" required />
                            <span asp-validation-for="CheckInDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="TimeSlot" class="form-label fw-medium">Время заезда</label>
                            <select asp-for="TimeSlot" class="form-select rounded-pill border-0 bg-light py-2 px-3">
                                <option value="14:00">14:00 (Стандарт)</option>
                                <option value="12:00">12:00 (Ранний заезд)</option>
                                <option value="16:00">16:00 (Вечерний заезд)</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-sakura w-100 rounded-pill py-3 fw-bold shadow-sm">Подтвердить бронирование</button>
                </form>
            </div>
        </div>
    </div>
</div>