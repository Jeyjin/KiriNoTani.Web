@model KiriNoTani.Web.Models.User

@{
ViewData["Title"] = "Личный кабинет";
var bookings = ViewBag.UserBookings as List<KiriNoTani.Web.Models.Booking>;
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Левая колонка: Профиль пользователя -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="text-center mb-3">
                    <div class="display-4 text-pink mb-2"><i class="bi bi-person-circle"></i></div>
                    <h3 class="h5 fw-bold mb-1">@Model.Name</h3>
                    <p class="text-muted small mb-2">@Model.Email</p>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Роль: @Model.Role</span>
                </div>
                <hr class="my-3 text-secondary border-opacity-25" />
                <div class="small text-muted mb-3">
                    <i class="bi bi-calendar3 me-2"></i>Дата регистрации: @Model.CreatedAt.ToString("dd.MM.yyyy")
                </div>
                <a asp-action="Logout" class="btn btn-outline-danger w-100 rounded-pill">Выйти из аккаунта</a>
            </div>
        </div>

        <!-- Правая колонка: История бронирований -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h3 class="h5 fw-bold mb-4">История ваших бронирований</h3>

                @if (bookings != null && bookings.Any())
                {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Услуга</th>
                            <th>Дата заезда</th>
                            <th>Время</th>
                            <th>Статус</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in bookings)
                        {
                        <tr>
                            <td class="fw-bold">#@item.Id</td>
                            <td>@(item.Service?.Title ?? "—")</td>
                            <td>@item.CheckInDate.ToString("dd.MM.yyyy")</td>
                            <td>@item.TimeSlot</td>
                            <td>
                                <span class="badge bg-light text-dark border px-3 py-1 rounded-pill">@item.Status</span>
                            </td>
                        </tr>
                        }
                        </tbody>
                    </table>
                </div>
                }
                else
                {
                <div class="text-center py-4 text-muted">
                    <p class="mb-3">У вас пока нет активных бронирований.</p>
                    <a asp-controller="Booking" asp-action="Create" class="btn btn-sakura rounded-pill px-4">Забронировать отдых</a>
                </div>
                }
            </div>
        </div>
    </div>
</div>